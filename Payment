const stripe = require('stripe')('your_secret_key_here');
const express = require('express');
const app = express();

app.use(express.json());

app.post('/create-checkout-session', async (req, res) => {
  const { vehicleType, amount } = req.body;

  try {
    const session = await stripe.checkout.sessions.create({
      payment_method_types: ['card'],
      line_items: [{
        price_data: {
          currency: 'usd',
          product_data: {
            name: `Jean Limo LLC - ${vehicleType}`,
          },
          unit_amount: amount * 100, // Amount in cents ($145.00 = 14500)
        },
        quantity: 1,
      }],
      mode: 'payment',
      success_url: 'https://jeanlimo.com/success?session_id={CHECKOUT_SESSION_ID}',
      cancel_url: 'https://jeanlimo.com/cancel',
    });

    res.json({ id: session.id });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.listen(4242, () => console.log('Stripe backend running on port 4242'));
